    "%@ was not quit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht beendet."
          }
        }
      }
    },
    "%@ will be updated from %@ to %@. Homebrew may also update dependent packages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird von %2$@ auf %3$@ aktualisiert. Homebrew kann dabei auch abhängige Pakete aktualisieren."
          }
        }
      }
    },
    "%@ will be updated from %@ to %@. Major updates can contain breaking changes. Homebrew may also update dependent packages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird von %2$@ auf %3$@ aktualisiert. Major-Updates können inkompatible Änderungen enthalten. Homebrew aktualisiert eventuell auch abhängige Pakete."
          }
        }
      }
    },
