{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ will be removed. This cannot be undone. This command will be run:\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ wird entfernt. Das lässt sich nicht rückgängig machen. Dieser Befehl wird ausgeführt:\n%3$@"
          }
        }
      }
    },
    "%@ (exit code %lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (Exit-Code %2$lld)"
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$lld weitere"
          }
        }
      }
    },
    "%@ cannot be updated automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht automatisch aktualisiert werden."
          }
        }
      }
    },
    "%@ detected: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ erkannt: %2$@"
          }
        }
      }
    },
    "%@ exited with code %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ endete mit Exit-Code %2$lld"
          }
        }
      }
    },
    "%@ exited with code %lld: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ endete mit Exit-Code %2$lld: %3$@"
          }
        }
      }
    },
    "%@ is not installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht installiert"
