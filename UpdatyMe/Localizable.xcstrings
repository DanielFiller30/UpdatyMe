    "Add the JAVA_HOME line to your shell profile (e.g. ~/.zshrc) to make it the default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die JAVA_HOME-Zeile in dein Shell-Profil (z. B. ~/.zshrc) eintragen, damit sie als Standard gilt."
